# Maintenance-tool deployment profile: production, rehearsal, devbot, or empty to infer it
# (DevBot's application ID infers devbot). Production and rehearsal runs use a copy of
# production.env.example passed with bun --env-file, never this file. See docs/CONFIGURATION.md.
TARUBOT_ENVIRONMENT=
# Use a URL-safe password or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=local-development-password
# DevBot's local tools must name its database, .../tarubot_dev; the devbot profile refuses others.
DATABASE_URL=postgresql://tarubot:local-development-password@localhost:5432/tarubot
# Optional PEM root CA for a hosted PostgreSQL endpoint. DO binds ${db.CA_CERT} at runtime.
# With a CA set, certificate/hostname verification is enforced over URL SSL flags. For the DO
# managed cluster this is its CA PEM, and tools connect as the app's db_user (tarubot), never doadmin.
DATABASE_CA_CERT=
# Optional CA for check-restore's RESTORE_DATABASE_URL (a PITR fork); empty reuses DATABASE_CA_CERT.
RESTORE_DATABASE_CA_CERT=
# Registry deployment defaults to latest; use a published SemVer or sha-COMMIT tag to pin a release.
TARUBOT_IMAGE_TAG=latest
# Optional full-image overrides also support immutable @sha256 digests.
TARUBOT_IMAGE=
NODESTONE_IMAGE=
# Discord identity for the selected development or production application.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# A value scopes development interactions/events to one guild; empty is normal scope.
TEST_GUILD_ID=
# When true, all new command/component replies in TEST_GUILD_ID are public.
# The DevBot Compose overlay enables this by default for observed test sessions.
PUBLIC_TEST_RESPONSES=false
# Development startup announcement; empty channel ID resolves #chat in TEST_GUILD_ID.
TEST_PLAN_CHANNEL_ID=
TEST_PLAN_FILE=test-plans/current.json
# Local-tool URL; Compose supplies its internal service URL to the bot container.
NODESTONE_URL=http://localhost:8080
# Inherited by isolated workers before Nodestone reads its import-time region constant.
PAGE_REGION=na
LOG_LEVEL=info
# Process-wide delivery switch, separate from each imported guild's activation flag.
ENABLE_EFFECTS=false
# Authoritative roster observations and public display refreshes have independent intervals.
ROSTER_INTERVAL_SECONDS=21600
PROFILE_INTERVAL_SECONDS=86400
# Proof expiry and denied-application cooldown are policy settings, in seconds.
VERIFICATION_SECONDS=1800
GUEST_COOLDOWN_SECONDS=86400
# Local liveness/readiness endpoint; probes never acquire Lodestone pages.
HEALTH_PORT=3000
# Sidecar concurrency, actual request spacing, fetch deadline, and streamed body bound.
LODESTONE_CONCURRENCY=2
LODESTONE_START_MS=1000
LODESTONE_TIMEOUT_MS=15000
LODESTONE_BODY_BYTES=2000000
# HTTP retries share the overall job deadline and bounded pagination/response budgets.
LODESTONE_REQUEST_TIMEOUT_MS=35000
LODESTONE_JOB_TIMEOUT_MS=300000
LODESTONE_ATTEMPTS=3
LODESTONE_MAX_PAGES=100
NODESTONE_RESPONSE_BYTES=8000000
# Monitor both upstream repositories hourly; use nodestone:update --deploy to refresh the sidecar.
NODESTONE_UPSTREAM_CHECK_SECONDS=3600
