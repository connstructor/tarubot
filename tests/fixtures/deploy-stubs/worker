#!/usr/bin/env bash
# A stand-in worker for the detachment test in tests/unit/deploy-script.test.ts, started through
# ops/deploy.sh's real `env -i … setsid -f` launch. Only HOME survives env -i, so it reports
# there: its environment, its arguments and whether it holds fd 8 (the run lock), then it finishes
# after its caller's process group has been hung up.
env >"$HOME/stub-env"
printf '%s\n' "$@" >"$HOME/stub-args"
if { : >&8; } 2>/dev/null; then printf 'open\n' >"$HOME/stub-fd8"; fi
: >"$HOME/stub-started"
sleep 2
: >"$HOME/stub-done"
