#!/usr/bin/env bash
# A simulated curl for tests/unit/deploy-script.test.ts: GitHub's run, jobs and approvals answers
# come from $SIM/run.json, $SIM/jobs.json and $SIM/approvals.json. From the second run request on,
# $SIM/run.later.json answers instead when it exists (a run cancelled after the first check). The
# knob $SIM/knob/curl makes the API unreachable.
set -euo pipefail
url=${*: -1}
printf '%s\n' "$url" >>"$SIM/api-calls"
if [[ -f $SIM/knob/curl ]]; then exit 7; fi
case $url in
  */approvals) cat "$SIM/approvals.json" ;;
  */jobs) cat "$SIM/jobs.json" ;;
  */actions/runs/*)
    n=$(($(cat "$SIM/run-fetches" 2>/dev/null || printf 0) + 1))
    printf '%s\n' "$n" >"$SIM/run-fetches"
    if ((n >= 2)) && [[ -f $SIM/run.later.json ]]; then
      cat "$SIM/run.later.json"
    else
      cat "$SIM/run.json"
    fi
    ;;
  *) exit 22 ;;
esac
