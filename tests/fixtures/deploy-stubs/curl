#!/usr/bin/env bash
# A simulated curl for tests/unit/deploy-script.test.ts: GitHub's run and approvals answers come
# from $SIM/run.json and $SIM/approvals.json; the knob $SIM/knob/curl makes the API unreachable.
set -euo pipefail
url=${*: -1}
printf '%s\n' "$url" >>"$SIM/api-calls"
if [[ -f $SIM/knob/curl ]]; then exit 7; fi
case $url in
  */approvals) cat "$SIM/approvals.json" ;;
  */actions/runs/*) cat "$SIM/run.json" ;;
  *) exit 22 ;;
esac
