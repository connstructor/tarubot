#!/usr/bin/env bash
# A simulated date for the plan step in tests/unit/deploy-workflow.test.ts: with $STUB/now
# ("<day of week> <HHMM>", UTC) it answers the plan's two questions; otherwise the real date runs.
if [[ -f $STUB/now ]]; then
  read -r day hm <"$STUB/now"
  case $* in
    *%u*) printf '%s\n' "$day" ;;
    *%H%M*) printf '%s\n' "$hm" ;;
    *) exec /bin/date "$@" ;;
  esac
  exit 0
fi
exec /bin/date "$@"
