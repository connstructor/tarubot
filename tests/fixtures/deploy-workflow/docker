#!/usr/bin/env bash
# A simulated `docker buildx imagetools inspect IMAGE:TAG --format …` for the plan job in
# tests/unit/deploy-workflow.test.ts: $STUB/images/<tag> holds "<digest> <revision>".
set -euo pipefail
[[ $1 == buildx && $2 == imagetools && $3 == inspect ]] || exit 1
tag=${4##*:}
[[ -f $STUB/images/$tag ]] || { printf 'ERROR: %s: not found\n' "$4" >&2; exit 1; }
read -r digest revision <"$STUB/images/$tag"
case $6 in
  '{{json .Manifest}}') printf '{"mediaType":"application/vnd.oci.image.index.v1+json","digest":"%s"}\n' "$digest" ;;
  '{{json .Image}}') printf '{"linux/amd64":{"config":{"Labels":{"org.opencontainers.image.revision":"%s"}}}}\n' "$revision" ;;
  *) exit 1 ;;
esac
