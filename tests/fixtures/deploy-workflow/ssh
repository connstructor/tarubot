#!/usr/bin/env bash
# A simulated ssh for tests/unit/deploy-workflow.test.ts. Each call takes the next behavior from
# $STUB/plan (one per line) and records its arguments, and whether the key's variable leaked, in
# $STUB/ssh-calls:
#   ok        the host's lines for a finished deploy, then exit 0
#   needs-you the lines of a run that needs the owner, then exit 1
#   warning   a migration in the maintenance window, then exit 0
#   partial   two step lines, then a dropped connection (255)
#   drop      a dropped connection with no output (255)
#   hostkey   a changed host key (255)       denied  a rejected key (255)
#   usage     the host's usage line (64)     quiet   no output, exit 1
#   noconnect no TCP connection (255); as the plan's last line it repeats for every later call
set -uo pipefail
n=$(($(cat "$STUB/n" 2>/dev/null || printf 0) + 1))
printf '%s\n' "$n" >"$STUB/n"
behavior=$(sed -n "${n}p" "$STUB/plan")
if [[ -z $behavior && $(tail -n 1 "$STUB/plan") == noconnect ]]; then behavior=noconnect; fi
{
  printf 'call %s: key-variable=%s\n' "$n" "${DEPLOY_SSH_KEY+set}"
  printf '%s\n' "$@"
} >>"$STUB/ssh-calls"
result() {
  printf 'result outcome=%s version=2.30.1 previous=2.30.0 path=%s downtime=%s commands=%s backup=- restore_point=- reason=%s\n' "$@"
}
case $behavior in
  ok)
    printf 'step preflight\nnoise ::error::from a tool\nstep up\n'
    result deployed plain 4 registered -
    ;;
  needs-you)
    printf 'step preflight\nstep up\n'
    result needs-you plain 9 skipped new-release-took-lease
    exit 1
    ;;
  warning)
    printf 'step preflight\nwarning db-maintenance-window\nstep stop\n'
    result deployed migration 31 registered -
    ;;
  partial)
    printf 'step preflight\nstep pull\n'
    exit 255
    ;;
  drop) exit 255 ;;
  hostkey)
    printf 'Host key verification failed.\n' >&2
    exit 255
    ;;
  denied)
    printf 'tarubot@host: Permission denied (publickey).\n' >&2
    exit 255
    ;;
  usage)
    printf 'usage: deploy <version> <commit> <digest> <run> | rollback <version> <commit> <digest> <run> <from>\n'
    exit 64
    ;;
  quiet) exit 1 ;;
  noconnect)
    printf 'ssh: connect to host deploy.example.invalid port 22: Connection timed out\n' >&2
    exit 255
    ;;
  *) exit 99 ;;
esac
